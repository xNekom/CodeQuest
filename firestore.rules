rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Helper functions ───────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── Users ──────────────────────────────────────────────────────────
    // Own document: full access for owner; admin override.
    // Other users' documents: admin only.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();

      // Sub-collections (missionProgress, inventory, badges)
      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Usernames (checked before Firebase Auth exists) ────────────────
    match /usernames/{username} {
      allow read:   if true;                                         // username availability check before sign-up
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Leaderboard ────────────────────────────────────────────────────
    match /leaderboard/{entryId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── User Achievements ──────────────────────────────────────────────
    match /user_achievements/{userId} {
      allow read:   if isAuth();
      allow write:  if isOwner(userId) || isAdmin();

      match /achievements/{achievementId} {
        allow read:   if isAuth();
        allow write:  if isOwner(userId) || isAdmin();
      }
    }

    // ─── Reference Data (read for authenticated, write for admin) ──────
    match /missions/{doc}         { allow read: if isAuth(); allow write: if isAdmin(); }
    match /questions/{doc}        { allow read: if isAuth(); allow write: if isAdmin(); }
    match /enemies/{doc}          { allow read: if isAuth(); allow write: if isAdmin(); }
    match /items/{doc}            { allow read: if isAuth(); allow write: if isAdmin(); }
    match /rewards/{doc}          { allow read: if isAuth(); allow write: if isAdmin(); }
    match /achievements/{doc}     { allow read: if isAuth(); allow write: if isAdmin(); }
    match /code_exercises/{doc}   { allow read: if isAuth(); allow write: if isAdmin(); }
  }
}
